{% extends 'base.html.twig' %}

{% block title %}Liste des Tâches{% endblock %}

{% block body %}
    <a href="{{ path('task_create') }}" class="btn btn-info pull-right">Créer une tâche</a>
    <div class="row">
        <h3>Liste des Tâches</h3>
        {% for task in tasks %}
        <div class="col-sm-3 col-lg-3 col-md-3">
            <div class="thumbnail">
                <div class="caption">
                    <h4 class="pull-right">
                        {% if task.isDone %}<span class="glyphicon glyphicon-ok"></span>{% else %}<span class="glyphicon glyphicon-remove"></span>{% endif %}
                    </h4>
                    <h4><a href="{{ path('task_edit', {'id' : task.id }) }}">{{ task.title }}</a></h4>
                    <p>{{ task.content }}</p>
                    {{ task.author is not empty ? task.author.username : 'Anonyme' }}
                    <p class="text-right">{{ task.createdAt | date('d/m/Y')}}</p>
                </div>
                <div>
                    <form action="{{ path('task_toggle', {'id' : task.id }) }}">
                        <button class="btn btn-success btn-sm pull-right">
                            {% if not task.isDone %}Marquer comme faite{% else %}Marquer non terminée{% endif %}
                        </button>
                    </form>
                    {% if app.user %}
                        {% if app.user == task.author or ('ROLE_ADMIN' in app.user.roles and (task.author is null or task.author.username == 'Anonyme')) %}
                        {# L'utilisateur est l'auteur de la tâche, ou il est administrateur et l'auteur est null / anonyme, donc a accès au bouton de suppression #}
                            <form method="POST" action="{{ path('task_delete', {'id' : task.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
                                <button type="submit" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette tâche ?')" class="btn btn-danger btn-sm pull-right">Supprimer</button>
                            </form>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>
        {% else %}
            <div class="alert alert-warning" role="alert">
                Il n'y a pas encore de tâche enregistrée. <a href="{{ path('task_create') }}" class="btn btn-warning pull-right">Créer une tâche</a>
            </div>
        {% endfor %}
    </div>
{% endblock %}
